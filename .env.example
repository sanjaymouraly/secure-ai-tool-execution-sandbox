# ---------------------------------------------------------------------------
# Secure AI Tool Execution & Permission Sandbox - environment configuration
#
# Copy this file to `.env` and adjust the values.  NEVER commit a populated
# `.env` file; `.gitignore` already excludes it.
# ---------------------------------------------------------------------------

# ----------------------------------------------------------------- general
SAXIS_ENVIRONMENT=development
SAXIS_DEBUG=false
SAXIS_LOG_LEVEL=INFO
SAXIS_LOG_JSON=true

# ----------------------------------------------------------------- secrets
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production - the application refuses to start without it.
SAXIS_SECRET_KEY=

# Fernet key used to encrypt provider API keys at rest.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SAXIS_PROVIDER_SECRET_KEY=

# --------------------------------------------------------------- database
# SQLite (development) or PostgreSQL (deployment).
#   postgresql+psycopg://saxis:password@localhost:5432/saxis
SAXIS_DATABASE_URL=sqlite:///./data/sandbox.db

# -------------------------------------------------------------------- auth
# multiuser = real accounts and sessions; local = single user, no password.
SAXIS_AUTH_MODE=multiuser
SAXIS_ACCESS_TOKEN_EXPIRE_MINUTES=60
SAXIS_REFRESH_TOKEN_EXPIRE_DAYS=14
SAXIS_ALLOW_REGISTRATION=false
SAXIS_BOOTSTRAP_ADMIN_USERNAME=admin
SAXIS_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-deploying
SAXIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
SAXIS_RATE_LIMIT_ENABLED=true
SAXIS_RATE_LIMIT_REQUESTS=120
SAXIS_RATE_LIMIT_WINDOW_SECONDS=60
SAXIS_RATE_LIMIT_LOGIN_REQUESTS=10
SAXIS_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# --------------------------------------------------------------- workspace
# The only directory tree AI agents may inspect.
SAXIS_WORKSPACE_ROOT=../sandbox_workspace
SAXIS_ARTIFACT_ROOT=./data/artifacts
SAXIS_JOB_ROOT=/tmp/saxis-jobs

# ----------------------------------------------------------------- sandbox
# docker = real container isolation (required in production).
# local-simulated = NOT isolated, for offline development only.
SAXIS_SANDBOX_BACKEND=docker
SAXIS_SANDBOX_IMAGE=secure-ai-sandbox-runner:latest
SAXIS_SANDBOX_PULL_IMAGE=true
SAXIS_SANDBOX_USER=10001:10001
SAXIS_SANDBOX_TIMEOUT_SECONDS=30
SAXIS_SANDBOX_MAX_OUTPUT_BYTES=262144
SAXIS_SANDBOX_MAX_MEMORY_MB=512
SAXIS_SANDBOX_MAX_CPU_CORES=1.0
SAXIS_SANDBOX_MAX_PIDS=64
SAXIS_SANDBOX_MAX_TMPFS_MB=64
SAXIS_SANDBOX_DENY_NETWORK=true
# Narrowly scoped network exceptions (host names), empty by default.
SAXIS_SANDBOX_ALLOW_NETWORK_EXCEPTIONS=
SAXIS_SANDBOX_SECCOMP_PROFILE=default
SAXIS_SANDBOX_APPARMOR_PROFILE=docker-default
SAXIS_SANDBOX_ROOTLESS=true
SAXIS_SANDBOX_DOCKER_BINARY=docker

# ------------------------------------------------------------------ docker
# The group that owns /var/run/docker.sock on the host.  The control plane
# container needs it to be able to start the sandbox containers.
#   stat -c '%g' /var/run/docker.sock
SAXIS_DOCKER_GID=999

# ------------------------------------------------------------------ policy
SAXIS_POLICY_FILE=./policies/default.yaml
SAXIS_POLICY_ALLOW_ADMIN_EDIT=true
SAXIS_POLICY_GRANT_TTL_SECONDS=3600

# ----------------------------------------------------------- AI providers
# ollama | openai | anthropic | openrouter | custom | simulation
SAXIS_DEFAULT_PROVIDER=ollama
SAXIS_PROVIDER_BASE_URL=http://localhost:11434/v1
SAXIS_PROVIDER_MODEL=qwen2.5:1.5b
# The API key is read from the environment only - never from the database in
# clear text and never from the repository.
SAXIS_PROVIDER_API_KEY=
SAXIS_PROVIDER_KEY_ENV_VAR=SAXIS_PROVIDER_API_KEY
SAXIS_PROVIDER_TIMEOUT_SECONDS=120
SAXIS_PROVIDER_MAX_RETRIES=2
SAXIS_PROVIDER_MAX_TOKENS=4096
SAXIS_PROVIDER_TEMPERATURE=0.2

# ----------------------------------------------------------------- budgets
SAXIS_BUDGET_ENABLED=true
SAXIS_BUDGET_SESSION_USD=1.00
SAXIS_BUDGET_DAILY_USD=10.00
SAXIS_COST_AWARE_ENABLED=true

# ------------------------------------------------------------------ agent
SAXIS_AGENT_MAX_STEPS=12
SAXIS_AGENT_MAX_TOOL_CALLS_PER_STEP=4
SAXIS_AGENT_STEP_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------ audit
SAXIS_AUDIT_RETENTION_DAYS=90
SAXIS_AUDIT_INTEGRITY_ENABLED=true
